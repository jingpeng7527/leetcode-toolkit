# 从浏览器 leetcode.com 的 Cookie 里复制（DevTools → Application → Cookies）
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# 不进入复习队列的难度，逗号分隔（默认 Easy；留空则全部保留）
EXCLUDE_DIFFICULTIES=Easy

# 公司题单（需要 Premium 的 Cookie），逗号分隔
COMPANIES=google,apple

# 可选集成
ANTHROPIC_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
# 你的刷题笔记根页面 ID（页面需共享给 integration），用于把笔记关联到数据库
NOTION_NOTES_PAGE_ID=
